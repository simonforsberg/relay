# This file documents all environment variables required in production.
# Locally, the dev profile (application-dev.properties) provides defaults for
# everything except secrets, only those need to be set in the .env file.
#
# ── Auth Service ─────────────────────────────────────────────────────────────
AUTH_SERVICE_GATEWAY_CLIENT_SECRET=
AUTH_SERVICE_CLIENT_SECRET=
AUTH_SERVICE_ISSUER_URI=
USER_SERVICE_BASE_URL=

# ── User Service ──────────────────────────────────────────────────────────────
USER_DB_URL=
USER_DB_USERNAME=
USER_DB_PASSWORD=

# ── Message Service ───────────────────────────────────────────────────────────
MESSAGE_DB_URL=
MESSAGE_DB_USERNAME=
MESSAGE_DB_PASSWORD=
USER_SERVICE_GRPC_ADDRESS=
AUTH_SERVICE_JWK_URI=
AUTH_SERVICE_TOKEN_URI=
RABBITMQ_HOST=
RABBITMQ_PORT=
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=

# ── BFF ───────────────────────────────────────────────────────────────────────
BFF_BASE_URL=
BFF_CLIENT_ID=
BFF_CLIENT_SECRET=
BFF_REDIRECT_URI=
USER_SERVICE_URL=
MESSAGE_SERVICE_URL=

# ── Docker Compose (PostgreSQL) ───────────────────────────────────────────────
# Required — Docker Compose will not start without this.
# The dev profile hardcodes 'postgres' as the DB password, so use that value locally.
POSTGRES_PASSWORD=
